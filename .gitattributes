* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Windows scripts keep Windows line ends (cmd.exe misreads some batch files without them)
*.cmd text eol=crlf
*.ps1 text eol=crlf
