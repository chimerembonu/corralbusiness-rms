# ---------------------------------------------------------------------------
# CorralBusiness – RMS  .env.example
# Copy this file to .env and fill in the values for your machine.
# Every variable is explained in plain English next to it.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Name shown in the browser tab, on receipts header defaults and in emails.
APP_NAME="CorralBusiness – RMS"
# local = your Mac while building. production = the restaurant's store server.
APP_ENV=local
# Secret key that encrypts sessions/cookies. Generated by `php artisan key:generate`. Never share it.
APP_KEY=
# true shows detailed error pages while building. MUST be false on the store server.
APP_DEBUG=true
# The web address of this installation. On the Mac with Herd it is http://corralbusiness-rms.test
APP_URL=http://corralbusiness-rms.test
# Timezone used for every date/time (orders, reports, Z-report cut-off).
APP_TIMEZONE=Africa/Accra

# Language of the interface. Only 'en' ships today (Twi/Ga/French are Phase 8).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

# --- RMS product settings --------------------------------------------------
# ISO currency code used by the money() helper. Amounts are stored in pesewas (integers).
RMS_CURRENCY=GHS
# Symbol printed before amounts on screens and receipts.
RMS_CURRENCY_SYMBOL=GH₵
# Which restaurant (slug) and branch (code) this store server runs for. Leave empty when
# the database holds only one restaurant – it is picked automatically. Demo: demo / MAIN.
RMS_STORE_TENANT=
RMS_STORE_BRANCH=
# Which Filament panel path the store manager uses (default /admin) and the tenant owner (default /hq).
RMS_ADMIN_PATH=admin
RMS_HQ_PATH=hq

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Number of PHP workers for `php artisan serve` (not used with Herd/nginx).
# PHP_CLI_SERVER_WORKERS=4

# Password/PIN hashing strength. 12 is a good default; higher = slower logins.
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
# Where error logs go. 'stack' + 'daily' keeps one file per day in storage/logs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8 / MariaDB 10.6+) -------------------------------------
# The store server and your Mac both use MySQL. SQLite is only used by automated tests.
DB_CONNECTION=mysql
# Where MySQL is running. On your Mac with DBngin/Homebrew it is 127.0.0.1 port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
# Name of the database that holds all restaurant data.
DB_DATABASE=corralbusiness_rms
# MySQL login. DBngin's default is user 'root' with no password.
DB_USERNAME=root
DB_PASSWORD=

# --- Sessions, cache, queues ------------------------------------------------
# All kept in the database so the app has no extra moving parts in the restaurant.
SESSION_DRIVER=database
# Minutes a logged-in browser stays logged in without activity (tills: long day).
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

# Background jobs (printing, stock deduction, sync). 'database' needs `php artisan queue:work` running.
QUEUE_CONNECTION=database

# --- Realtime (Laravel Reverb WebSockets) for the kitchen display ----------
# 'reverb' pushes new tickets to kitchen screens instantly. Start it with `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb
# Credentials shared between the app and the Reverb server. Any random strings; generated at install.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the app itself (PHP) reaches the Reverb server to push events. On the Mac that is localhost:8080.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server itself listens (0.0.0.0 = every network card on the machine).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# What the BROWSER connects to (printed into every page, read by resources/js/echo.js).
# Leave a value empty to use the same address/port/scheme as the page; on the Mac Reverb listens on 8080.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=
REVERB_CLIENT_PATH=

# Store server only (Docker): LAN address and port the app listens on. See docs/STORE-SERVER.md.
RMS_BIND_IP=0.0.0.0
RMS_HTTP_PORT=80
DB_ROOT_PASSWORD=

# --- Files ------------------------------------------------------------------
# Where uploaded item images and backups are stored. 'local' = storage/app on this machine.
FILESYSTEM_DISK=local

# --- Optional Redis (faster cache/queues; not required) ---------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# --- Email (only used for password resets / reports by email; log = write to a file) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@corralsystems.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cloud storage (unused until Phase 6 off-site backups) ------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backups are locked (AES-256) with this password. Empty = a password derived from APP_KEY.
# Show the one in use with: php artisan rms:backup --show-password
RMS_BACKUP_PASSWORD=

# Corral Systems office only: path to the secret licence signing key file (made by rms:licence-keys),
# used by rms:licence-issue. NEVER set this on a restaurant's server.
RMS_LICENCE_SIGNING_KEY=

# First-run setup wizard (/setup): if set, the wizard asks for this code first. The installer generates one
# and prints it. Not needed once the restaurant is set up.
RMS_SETUP_CODE=
