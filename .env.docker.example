# ---------------------------------------------------------------------------
# CorralBusiness – RMS: settings for the STORE SERVER (Docker).
# install.sh copies this to .env and fills in the generated keys and passwords.
# Every line marked "(set by install)" is filled automatically.
# ---------------------------------------------------------------------------
APP_NAME="CorralBusiness – RMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                     # (set by install) encryption key
APP_URL=http://rms.local     # (set by install) the server's address as tills see it, e.g. http://192.168.8.10
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

RMS_CURRENCY=GHS
RMS_CURRENCY_SYMBOL=GH₵
RMS_STORE_TENANT=            # restaurant slug (set by rms:setup); leave empty when only one restaurant exists
RMS_STORE_BRANCH=            # branch code; leave empty when only one branch exists
RMS_ADMIN_PATH=admin
RMS_HQ_PATH=hq

# Network: the LAN address of this server. Services bind to it only, never to a public interface.
RMS_BIND_IP=127.0.0.1        # (set by install) the server's LAN address, e.g. 192.168.8.10 – 127.0.0.1 means only this machine can reach it
RMS_HTTP_PORT=80

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=corralbusiness_rms
DB_USERNAME=rms
DB_PASSWORD=                 # (set by install)
DB_ROOT_PASSWORD=            # (set by install)

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Realtime (kitchen screens). Browsers connect through nginx on the same port as the app, path /reverb.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=               # (set by install)
REVERB_APP_KEY=              # (set by install)
REVERB_APP_SECRET=           # (set by install)
REVERB_HOST=                 # empty = browsers use the address they opened the app on
REVERB_PORT=80
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_REVERB_PATH=/reverb

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@corralsystems.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
