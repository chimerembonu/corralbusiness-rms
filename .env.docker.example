# ---------------------------------------------------------------------------
# CorralBusiness – RMS: settings for the STORE SERVER (Docker).
# install.sh copies this to .env and fills in the generated keys and passwords.
# Every line marked "(set by install)" is filled automatically.
# ---------------------------------------------------------------------------
APP_NAME="CorralBusiness – RMS"
APP_ENV=production
APP_DEBUG=false
# (set by install) encryption key
APP_KEY=
# (set by install) the server's address as tills see it, e.g. http://192.168.8.10
APP_URL=http://rms.local
APP_TIMEZONE=Africa/Accra
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GH

RMS_CURRENCY=GHS
RMS_CURRENCY_SYMBOL=GH₵
# restaurant slug (set by rms:setup); leave empty when only one restaurant exists
RMS_STORE_TENANT=
# branch code; leave empty when only one branch exists
RMS_STORE_BRANCH=
RMS_ADMIN_PATH=admin
RMS_HQ_PATH=hq

# Network: the LAN address of this server. Services bind to it only, never to a public interface.
# (set by install) the server's LAN address, e.g. 192.168.8.10 – 127.0.0.1 means only this machine can reach it
RMS_BIND_IP=127.0.0.1
RMS_HTTP_PORT=80
# Where USB sticks appear on this computer (backup copies). Ubuntu: /media. Docker Desktop on Windows/Mac: a shared folder, e.g. /Users/you/rms-usb
# RMS_USB_DIR=/media

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=corralbusiness_rms
DB_USERNAME=rms
# (set by install)
DB_PASSWORD=
# (set by install)
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Realtime (kitchen screens). The app containers reach the Reverb container directly (REVERB_HOST=reverb);
# browsers connect through nginx on the same address and port as the app, under the path /reverb.
BROADCAST_CONNECTION=reverb
# (set by install)
REVERB_APP_ID=
# (set by install)
REVERB_APP_KEY=
# (set by install)
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# What the BROWSER connects to. Leave host/port/scheme empty = the address the till opened the app on.
REVERB_CLIENT_HOST=
REVERB_CLIENT_PORT=
REVERB_CLIENT_SCHEME=
REVERB_CLIENT_PATH=/reverb

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@corralsystems.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"

# Backups are locked (AES-256) with this password. The installer fills it in and shows it once – write it down.
# Needed to restore a backup on a replacement computer. Empty = a password derived from APP_KEY.
RMS_BACKUP_PASSWORD=

# First-run setup wizard (/setup): the installer fills in a 6-digit code and prints it; the wizard asks for it.
RMS_SETUP_CODE=
